<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TherapistPerformance" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30">

    <parameter name="fromDate" class="java.lang.String"/>
    <parameter name="toDate" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT id, name, specialization, contact_number, email
            FROM therapists
            ORDER BY name ASC
        ]]>
    </queryString>

    <field name="id" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="specialization" class="java.lang.String"/>
    <field name="contact_number" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="535" height="35"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Serenity Mental Health Therapy Center]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="35" width="535" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Therapist Roster and Performance]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="70" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Therapist ID]]></text></staticText>
            <staticText><reportElement x="70" y="0" width="130" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Name]]></text></staticText>
            <staticText><reportElement x="200" y="0" width="120" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Specialization]]></text></staticText>
            <staticText><reportElement x="320" y="0" width="100" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Contact Number]]></text></staticText>
            <staticText><reportElement x="420" y="0" width="115" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Email]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="70" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
            <textField><reportElement x="70" y="0" width="130" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
            <textField><reportElement x="200" y="0" width="120" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{specialization}]]></textFieldExpression></textField>
            <textField><reportElement x="320" y="0" width="100" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{contact_number}]]></textFieldExpression></textField>
            <textField><reportElement x="420" y="0" width="115" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{email}]]></textFieldExpression></textField>
        </band>
    </detail>

</jasperReport>
