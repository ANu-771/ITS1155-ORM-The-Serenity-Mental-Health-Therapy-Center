<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="FinancialSummary" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <parameter name="fromDate" class="java.lang.String"/>
    <parameter name="toDate" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT p.payment_id, p.amount, p.payment_date, p.payment_method, p.status,
                   pat.name AS patient_name, tp.name AS program_name
            FROM payments p
            JOIN patients pat ON p.patient_id = pat.id
            JOIN therapy_programs tp ON p.program_id = tp.program_id
            ORDER BY p.payment_date DESC
        ]]>
    </queryString>

    <field name="payment_id" class="java.lang.String"/>
    <field name="amount" class="java.lang.Double"/>
    <field name="payment_date" class="java.lang.String"/>
    <field name="payment_method" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="patient_name" class="java.lang.String"/>
    <field name="program_name" class="java.lang.String"/>

    <variable name="totalAmount" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>

    <title>
        <band height="90">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="90" backcolor="#3B82F6"/>
                <staticText>
                    <reportElement x="0" y="15" width="555" height="35" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="26" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Serenity Mental Health Therapy Center]]></text>
                </staticText>
                <staticText>
                    <reportElement x="0" y="55" width="555" height="20" forecolor="#E0E7FF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="12"/>
                    </textElement>
                    <text><![CDATA[Financial Summary Report]]></text>
                </staticText>
                <textField pattern="MMMMM dd, yyyy">
                    <reportElement x="380" y="70" width="165" height="15" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="30" backcolor="#F3F4F6"/>
                <staticText>
                    <reportElement x="0" y="0" width="60" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[ID]]></text>
                </staticText>
                <staticText>
                    <reportElement x="60" y="0" width="110" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Patient]]></text>
                </staticText>
                <staticText>
                    <reportElement x="170" y="0" width="130" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Program]]></text>
                </staticText>
                <staticText>
                    <reportElement x="300" y="0" width="80" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Amount]]></text>
                </staticText>
                <staticText>
                    <reportElement x="380" y="0" width="70" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Date]]></text>
                </staticText>
                <staticText>
                    <reportElement x="450" y="0" width="55" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Method]]></text>
                </staticText>
                <staticText>
                    <reportElement x="505" y="0" width="50" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Status]]></text>
                </staticText>
            </frame>
        </band>
    </columnHeader>

    <detail>
        <band height="30">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="0" y="0" width="60" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{payment_id}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="60" y="0" width="110" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{patient_name}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="170" y="0" width="130" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{program_name}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="300" y="0" width="80" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA["LKR " + String.format("%,.2f", $F{amount})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="380" y="0" width="70" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{payment_date}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="450" y="0" width="55" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{payment_method}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="505" y="0" width="50" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="29" width="555" height="1" forecolor="#E5E7EB"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="435" y="10" width="80" height="20" forecolor="#6B7280"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Page "+$V{PAGE_NUMBER}+" of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="515" y="10" width="40" height="20" forecolor="#6B7280"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="10" width="200" height="20" forecolor="#6B7280"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Developed by Anu Soft]]></text>
            </staticText>
        </band>
    </pageFooter>

    <summary>
        <band height="40">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="40" backcolor="#E0F2FE"/>
                <staticText>
                    <reportElement x="170" y="0" width="130" height="40" forecolor="#0369A1"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="14" isBold="true"/>
                        <paragraph rightIndent="10"/>
                    </textElement>
                    <text><![CDATA[TOTAL REVENUE:]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement x="300" y="0" width="255" height="40" forecolor="#0369A1"/>
                    <textElement verticalAlignment="Middle">
                        <font size="14" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA["LKR " + String.format("%,.2f", $V{totalAmount})]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </summary>

</jasperReport>
