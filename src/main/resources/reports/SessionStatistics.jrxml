<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="SessionStatistics" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30">

    <parameter name="fromDate" class="java.lang.String"/>
    <parameter name="toDate" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT ts.session_id, ts.date, ts.time, ts.status,
                   pat.name AS patient_name, ther.name AS therapist_name
            FROM therapy_sessions ts
            JOIN patients pat ON ts.patient_id = pat.id
            JOIN therapists ther ON ts.therapist_id = ther.id
            ORDER BY ts.date DESC, ts.time DESC
        ]]>
    </queryString>

    <field name="session_id" class="java.lang.String"/>
    <field name="date" class="java.lang.String"/>
    <field name="time" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="patient_name" class="java.lang.String"/>
    <field name="therapist_name" class="java.lang.String"/>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="535" height="35"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Serenity Mental Health Therapy Center]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="35" width="535" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Therapy Session Statistics]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="60" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Session ID]]></text></staticText>
            <staticText><reportElement x="60" y="0" width="80" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Date]]></text></staticText>
            <staticText><reportElement x="140" y="0" width="60" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Time]]></text></staticText>
            <staticText><reportElement x="200" y="0" width="120" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Patient]]></text></staticText>
            <staticText><reportElement x="320" y="0" width="120" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Therapist]]></text></staticText>
            <staticText><reportElement x="440" y="0" width="95" height="25"/><textElement><font isBold="true" size="9"/></textElement><text><![CDATA[Status]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="60" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{session_id}]]></textFieldExpression></textField>
            <textField><reportElement x="60" y="0" width="80" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{date}]]></textFieldExpression></textField>
            <textField><reportElement x="140" y="0" width="60" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{time}]]></textFieldExpression></textField>
            <textField><reportElement x="200" y="0" width="120" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{patient_name}]]></textFieldExpression></textField>
            <textField><reportElement x="320" y="0" width="120" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{therapist_name}]]></textFieldExpression></textField>
            <textField><reportElement x="440" y="0" width="95" height="20"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{status}]]></textFieldExpression></textField>
        </band>
    </detail>

</jasperReport>
