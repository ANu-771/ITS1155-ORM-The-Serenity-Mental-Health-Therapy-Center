<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="SessionStatistics" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <parameter name="fromDate" class="java.lang.String"/>
    <parameter name="toDate" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT ts.session_id, ts.date, ts.time, ts.status,
                   pat.name AS patient_name, ther.name AS therapist_name
            FROM therapy_sessions ts
            JOIN patients pat ON ts.patient_id = pat.id
            JOIN therapists ther ON ts.therapist_id = ther.id
            ORDER BY ts.date DESC, ts.time DESC
        ]]>
    </queryString>

    <field name="session_id" class="java.lang.String"/>
    <field name="date" class="java.lang.String"/>
    <field name="time" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="patient_name" class="java.lang.String"/>
    <field name="therapist_name" class="java.lang.String"/>

    <title>
        <band height="90">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="90" backcolor="#3B82F6"/>
                <staticText>
                    <reportElement x="0" y="15" width="555" height="35" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="26" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Therapy Session Statistics]]></text>
                </staticText>
                <staticText>
                    <reportElement x="0" y="55" width="555" height="20" forecolor="#E0E7FF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font size="12"/>
                    </textElement>
                    <text><![CDATA[Serenity Mental Health Therapy Center]]></text>
                </staticText>
                <textField pattern="MMMMM dd, yyyy">
                    <reportElement x="380" y="70" width="165" height="15" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="30" backcolor="#F3F4F6"/>
                <staticText>
                    <reportElement x="0" y="0" width="65" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[ID]]></text>
                </staticText>
                <staticText>
                    <reportElement x="65" y="0" width="80" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Date]]></text>
                </staticText>
                <staticText>
                    <reportElement x="145" y="0" width="65" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Time]]></text>
                </staticText>
                <staticText>
                    <reportElement x="210" y="0" width="125" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Patient]]></text>
                </staticText>
                <staticText>
                    <reportElement x="335" y="0" width="125" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Therapist]]></text>
                </staticText>
                <staticText>
                    <reportElement x="460" y="0" width="95" height="30" forecolor="#374151"/>
                    <textElement verticalAlignment="Middle">
                        <font size="12" isBold="true"/>
                        <paragraph leftIndent="10"/>
                    </textElement>
                    <text><![CDATA[Status]]></text>
                </staticText>
            </frame>
        </band>
    </columnHeader>

    <detail>
        <band height="30">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="0" y="0" width="65" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{session_id}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="65" y="0" width="80" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="145" y="0" width="65" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{time}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="210" y="0" width="125" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{patient_name}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="335" y="0" width="125" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{therapist_name}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="460" y="0" width="95" height="29" forecolor="#1F2937"/>
                <textElement verticalAlignment="Middle">
                    <font size="11"/>
                    <paragraph leftIndent="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="29" width="555" height="1" forecolor="#E5E7EB"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="435" y="10" width="80" height="20" forecolor="#6B7280"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Page "+$V{PAGE_NUMBER}+" of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="515" y="10" width="40" height="20" forecolor="#6B7280"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="10" width="200" height="20" forecolor="#6B7280"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Developed by Anu Soft]]></text>
            </staticText>
        </band>
    </pageFooter>

</jasperReport>
