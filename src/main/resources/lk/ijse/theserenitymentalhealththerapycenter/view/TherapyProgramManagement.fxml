<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<AnchorPane stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.TherapyProgramManagementController">
    <VBox spacing="18" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <VBox spacing="16" styleClass="card">
            <Label text="Therapy Program Details" styleClass="card-header"/>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Program ID" styleClass="form-label"/><TextField fx:id="txtProgramId" promptText="MT1001" styleClass="text-field-modern" prefHeight="38"/></VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Program Name" styleClass="form-label"/><ComboBox fx:id="cmbProgramName" promptText="Select Therapy Program" styleClass="combo-modern" prefHeight="38" maxWidth="Infinity"/></VBox>
                <VBox spacing="4"><Label text="Duration" styleClass="form-label"/><TextField fx:id="txtDuration" promptText="e.g. 12 weeks" styleClass="text-field-modern" prefHeight="38" prefWidth="140" editable="false"/></VBox>
                <VBox spacing="4"><Label text="Fee (LKR)" styleClass="form-label"/><TextField fx:id="txtFee" promptText="e.g. 80000.00" styleClass="text-field-modern" prefHeight="38" prefWidth="140" editable="false"/></VBox>
            </HBox>
            <VBox spacing="4">
                <Label text="Description" styleClass="form-label"/>
                <TextArea fx:id="txtDescription" promptText="Enter program description..." prefRowCount="2" styleClass="text-area-modern"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Save" styleClass="btn-save" onAction="#handleSave" prefWidth="100"/>
                <Button text="Update" styleClass="btn-update" onAction="#handleUpdate" prefWidth="100"/>
                <Button text="Delete" styleClass="btn-delete" onAction="#handleDelete" prefWidth="100"/>
                <Button text="Clear" styleClass="btn-clear" onAction="#handleClear" prefWidth="100"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtSearch" promptText="🔍  Search..." styleClass="search-field" prefWidth="220" prefHeight="36" onKeyReleased="#handleSearch"/>
            </HBox>
        </VBox>

        <TableView fx:id="tblPrograms" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="Program ID" prefWidth="100"><cellValueFactory><PropertyValueFactory property="programId"/></cellValueFactory></TableColumn>
                <TableColumn fx:id="colName" text="Name" prefWidth="220"><cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory></TableColumn>
                <TableColumn fx:id="colDuration" text="Duration" prefWidth="110"><cellValueFactory><PropertyValueFactory property="duration"/></cellValueFactory></TableColumn>
                <TableColumn fx:id="colFee" text="Fee (LKR)" prefWidth="120"><cellValueFactory><PropertyValueFactory property="fee"/></cellValueFactory></TableColumn>
                <TableColumn fx:id="colDescription" text="Description" prefWidth="220"><cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory></TableColumn>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
