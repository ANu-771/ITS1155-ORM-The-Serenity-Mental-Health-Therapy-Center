<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../style/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.SessionManagementController">
    <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #ffffff; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <VBox spacing="18" style="-fx-padding: 10;">
        <VBox spacing="16" styleClass="card">
            <Label styleClass="card-header" text="Session Scheduling &amp; Payments" />

            <!-- TOP SECTION: Selection -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Select Patient" /><ComboBox fx:id="cmbPatient" maxWidth="1.7976931348623157E308" prefHeight="38" promptText="Select Patient" styleClass="combo-modern" /></VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Select Program" /><ComboBox fx:id="cmbProgram" maxWidth="1.7976931348623157E308" prefHeight="38" promptText="Select Program" styleClass="combo-modern" /></VBox>
            </HBox>

            <Separator style="-fx-padding: 5 0;" />

            <!-- MIDDLE SECTION: Financial Summary -->
            <HBox alignment="CENTER" spacing="16">
                <VBox alignment="CENTER" spacing="4" styleClass="pastel-card, pastel-card-1" HBox.hgrow="ALWAYS">
                    <Label styleClass="card-subtitle" text="Total Program Fee" />
                    <Label fx:id="lblTotalFee" styleClass="card-number" text="0.00" />
                </VBox>
                <VBox alignment="CENTER" spacing="4" styleClass="pastel-card, pastel-card-2" HBox.hgrow="ALWAYS">
                    <Label styleClass="card-subtitle" text="Paid Amount" />
                    <Label fx:id="lblPaidAmount" styleClass="card-number" text="0.00" />
                </VBox>
                <VBox alignment="CENTER" spacing="4" styleClass="pastel-card, pastel-card-3" HBox.hgrow="ALWAYS">
                    <Label styleClass="card-subtitle" text="Due Balance" />
                    <Label fx:id="lblDueBalance" styleClass="card-number" text="0.00" />
                </VBox>
                <VBox alignment="CENTER" spacing="4" styleClass="pastel-card, pastel-card-4" HBox.hgrow="ALWAYS">
                    <Label styleClass="card-subtitle" text="Prepaid Sessions Available" />
                    <Label fx:id="lblPrepaidSessions" styleClass="card-number" text="0" />
                </VBox>
            </HBox>

            <Separator style="-fx-padding: 5 0;" />

            <!-- BOTTOM SECTION: Terminals -->
            <HBox spacing="24">
                <!-- Left Panel: Payment Terminal -->
                <VBox spacing="12" style="-fx-background-color: #f8f9fa; -fx-padding: 16; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label styleClass="card-header" text="Process Payment" />
                    <VBox spacing="4"><Label styleClass="form-label" text="Payment Amount" /><TextField fx:id="txtPaymentAmount" prefHeight="38" promptText="Enter Amount" styleClass="text-field-modern" /></VBox>
                    <VBox spacing="4"><Label styleClass="form-label" text="Payment Method" /><ComboBox fx:id="cmbPaymentMethod" maxWidth="1.7976931348623157E308" prefHeight="38" promptText="Select Method" styleClass="combo-modern" /></VBox>
                    <Button fx:id="btnProcessPayment" maxWidth="1.7976931348623157E308" onAction="#handleProcessPayment" prefHeight="40" style="-fx-background-color: white; -fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1.5; -fx-cursor: hand;" text="Process Payment" />
                </VBox>

                <!-- Right Panel: Booking Terminal -->
                <VBox spacing="12" style="-fx-background-color: #f8f9fa; -fx-padding: 16; -fx-border-color: #dee2e6; -fx-border-radius: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label styleClass="card-header" text="Schedule Session" />
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Session ID" /><TextField fx:id="txtSessionId" prefHeight="38" promptText="S001" styleClass="text-field-modern" /></VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Status" /><ComboBox fx:id="cmbStatus" maxWidth="1.7976931348623157E308" prefHeight="38" promptText="Select" styleClass="combo-modern" /></VBox>
                    </HBox>
                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Date" /><DatePicker fx:id="dpDate" maxWidth="1.7976931348623157E308" prefHeight="38" promptText="Select Date" styleClass="date-picker-modern" /></VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Time" /><ComboBox fx:id="cmbTime" maxWidth="1.7976931348623157E308" prefHeight="38" promptText="Select Time" styleClass="combo-modern" /></VBox>
                    </HBox>
                    <VBox spacing="4"><Label styleClass="form-label" text="Therapist" /><ComboBox fx:id="cmbTherapist" maxWidth="1.7976931348623157E308" prefHeight="38" promptText="Select Therapist" styleClass="combo-modern" /></VBox>
                    
                    <HBox spacing="10">
                        <Button fx:id="btnScheduleSession" maxWidth="1.7976931348623157E308" onAction="#handleSave" prefHeight="40" style="-fx-background-color: white; -fx-text-fill: #2E7D32; -fx-font-weight: bold; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1.5; -fx-cursor: hand;" text="Schedule Session" HBox.hgrow="ALWAYS" />
                        <Button minWidth="-Infinity" onAction="#handleUpdate" prefHeight="40" styleClass="btn-update" text="Update" />
                        <Button minWidth="-Infinity" onAction="#handleDelete" prefHeight="40" styleClass="btn-delete" text="Delete" />
                        <Button minWidth="-Infinity" onAction="#handleClear" prefHeight="40" styleClass="btn-clear" text="Clear" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>

        <TableView fx:id="tblSessions" VBox.vgrow="ALWAYS" minHeight="300">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70" text="ID"><cellValueFactory><PropertyValueFactory property="sessionId" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colDate" prefWidth="100" text="Date"><cellValueFactory><PropertyValueFactory property="date" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colTime" prefWidth="90" text="Time"><cellValueFactory><PropertyValueFactory property="time" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colStatus" prefWidth="100" text="Status"><cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colPatient" prefWidth="140" text="Patient"><cellValueFactory><PropertyValueFactory property="patientName" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colTherapist" prefWidth="140" text="Therapist"><cellValueFactory><PropertyValueFactory property="therapistName" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colProgram" prefWidth="140" text="Program"><cellValueFactory><PropertyValueFactory property="programName" /></cellValueFactory></TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        </VBox>
    </ScrollPane>
</AnchorPane>
