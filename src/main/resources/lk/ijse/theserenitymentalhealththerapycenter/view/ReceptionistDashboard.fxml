<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="1000.0"
            stylesheets="@../styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.ReceptionistDashboardController">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="220" styleClass="sidebar" spacing="4">
            <padding><Insets top="20" right="12" bottom="20" left="12"/></padding>

            <Label text="🌿 Serenity" styleClass="sidebar-title"/>
            <Label text="Receptionist Dashboard" styleClass="sidebar-subtitle">
                <VBox.margin><Insets bottom="30"/></VBox.margin>
            </Label>

            <Button fx:id="btnDashboard" text="📊  Dashboard" styleClass="sidebar-btn" maxWidth="1.7976931348623157E308" onAction="#handleDashboard"/>
            <Button fx:id="btnPatients" text="🧑  Patient Management" styleClass="sidebar-btn" maxWidth="1.7976931348623157E308" onAction="#handlePatients"/>
            <Button fx:id="btnSessions" text="📅  Sessions" styleClass="sidebar-btn" maxWidth="1.7976931348623157E308" onAction="#handleSessions"/>
            <Button fx:id="btnPayments" text="💳  Payments" styleClass="sidebar-btn" maxWidth="1.7976931348623157E308" onAction="#handlePayments"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnLogout" text="🚪  Logout" styleClass="sidebar-btn-logout" maxWidth="1.7976931348623157E308" onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content-area">
            <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

            <Label fx:id="lblHeader" text="Dashboard" styleClass="content-header">
                <VBox.margin><Insets bottom="20"/></VBox.margin>
            </Label>

            <AnchorPane fx:id="contentPane" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
