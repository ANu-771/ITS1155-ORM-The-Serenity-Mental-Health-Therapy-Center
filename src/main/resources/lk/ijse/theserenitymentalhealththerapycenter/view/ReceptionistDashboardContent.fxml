<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.ReceptionistDashboardContentController">

    <VBox spacing="24">
        <padding><Insets bottom="20" left="4" right="4" top="8" /></padding>

        <!-- ===== Stats Cards Row ===== -->
        <HBox spacing="16">
            <!-- Today's Sessions -->
            <VBox alignment="CENTER" spacing="8" styleClass="pastel-card, pastel-card-1" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <image>
                        <Image url="@../image/sessions.png" />
                    </image>
                </ImageView>
                <Label fx:id="lblTodaySessions" styleClass="card-number" text="0" />
                <Label styleClass="card-subtitle" text="Today's Sessions" />
            </VBox>

            <!-- Pending Payments -->
            <VBox alignment="CENTER" spacing="8" styleClass="pastel-card, pastel-card-3" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <image>
                        <Image url="@../image/payment.png" />
                    </image>
                </ImageView>
                <Label fx:id="lblPendingPayments" styleClass="card-number" text="0" />
                <Label styleClass="card-subtitle" text="Pending Payments" />
            </VBox>

            <!-- New Patients -->
            <VBox alignment="CENTER" spacing="8" styleClass="pastel-card, pastel-card-2" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <image>
                        <Image url="@../image/patient.png" />
                    </image>
                </ImageView>
                <Label fx:id="lblNewPatients" styleClass="card-number" text="0" />
                <Label styleClass="card-subtitle" text="New Patients" />
            </VBox>
        </HBox>

        <!-- ===== Chart Row ===== -->
        <VBox styleClass="card" VBox.vgrow="ALWAYS" minHeight="350">
            <Label styleClass="card-header" text="Recent Income (Last 7 Days)" />
            <javafx.scene.chart.BarChart fx:id="incomeChart" VBox.vgrow="ALWAYS" legendVisible="false">
                <xAxis>
                    <javafx.scene.chart.CategoryAxis label="Dates" side="BOTTOM" />
                </xAxis>
                <yAxis>
                    <javafx.scene.chart.NumberAxis label="Income" side="LEFT" />
                </yAxis>
            </javafx.scene.chart.BarChart>
        </VBox>

    </VBox>
</ScrollPane>
