<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.AdminDashboardContentController">

    <VBox spacing="24">
        <padding><Insets bottom="20" left="4" right="4" top="8" /></padding>

        <!-- ===== Stats Cards Row ===== -->
        <HBox spacing="16">
            <!-- Total Patients -->
            <VBox alignment="CENTER" spacing="8" styleClass="pastel-card, pastel-card-1" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <image>
                        <Image url="@../image/patient.png" />
                    </image>
                </ImageView>
                <Label fx:id="lblTotalPatients" styleClass="card-number" text="0" />
                <Label styleClass="card-subtitle" text="Total Patients" />
            </VBox>

            <!-- Active Therapists -->
            <VBox alignment="CENTER" spacing="8" styleClass="pastel-card, pastel-card-2" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <image>
                        <Image url="@../image/therapist.png" />
                    </image>
                </ImageView>
                <Label fx:id="lblActiveTherapists" styleClass="card-number" text="0" />
                <Label styleClass="card-subtitle" text="Active Therapists" />
            </VBox>

            <!-- Total Programs -->
            <VBox alignment="CENTER" spacing="8" styleClass="pastel-card, pastel-card-4" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <image>
                        <Image url="@../image/programme.png" />
                    </image>
                </ImageView>
                <Label fx:id="lblTotalPrograms" styleClass="card-number" text="0" />
                <Label styleClass="card-subtitle" text="Total Programs" />
            </VBox>

            <!-- Total Revenue -->
            <VBox alignment="CENTER" spacing="8" styleClass="pastel-card, pastel-card-3" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                    <image>
                        <Image url="@../image/revenue.png" />
                    </image>
                </ImageView>
                <Label fx:id="lblTotalRevenue" styleClass="card-number" text="LKR 0" />
                <Label styleClass="card-subtitle" text="Total Revenue" />
            </VBox>
        </HBox>

        <!-- ===== Chart Row ===== -->
        <VBox styleClass="card" VBox.vgrow="ALWAYS" minHeight="350">
            <Label styleClass="card-header" text="Total Revenue Growth (Last 6 Months)" />
            <javafx.scene.chart.AreaChart fx:id="revenueChart" VBox.vgrow="ALWAYS" legendVisible="false">
                <xAxis>
                    <javafx.scene.chart.CategoryAxis label="Months" side="BOTTOM" />
                </xAxis>
                <yAxis>
                    <javafx.scene.chart.NumberAxis label="Revenue" side="LEFT" />
                </yAxis>
            </javafx.scene.chart.AreaChart>
        </VBox>

    </VBox>
</ScrollPane>
