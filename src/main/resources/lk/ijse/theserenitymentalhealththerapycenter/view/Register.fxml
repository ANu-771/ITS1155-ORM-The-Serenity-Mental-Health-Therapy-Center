<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="550.0" prefWidth="900.0" styleClass="login-container" stylesheets="@../style/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.RegisterController">

    <VBox alignment="CENTER" styleClass="login-left-panel" HBox.hgrow="ALWAYS">
        <padding><Insets bottom="50" left="60" right="60" top="50" /></padding>

        <VBox alignment="CENTER_LEFT" maxWidth="480" spacing="24" styleClass="login-card">
            <padding><Insets bottom="45" left="45" right="45" top="45" /></padding>
            <!-- Header -->
            <VBox spacing="6">
                <Label styleClass="login-card-title" text="Create an Account" />
                <Label styleClass="login-card-subtitle" text="Sign up to access the therapy center dashboard" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="Username" />
                <TextField fx:id="txtUsername" promptText="Enter a unique username" styleClass="text-field-modern" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="Email" />
                <TextField fx:id="txtEmail" promptText="Enter your email address" styleClass="text-field-modern" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="Password" />
                <PasswordField fx:id="txtPassword" promptText="Enter a strong password" styleClass="password-field-modern" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="Role" />
                <ComboBox fx:id="cmbRole" maxWidth="1.7976931348623157E308" promptText="Select your role" styleClass="combo-modern" />
            </VBox>

            <!-- Error Message -->
            <Label fx:id="lblError" styleClass="error-label" visible="false" wrapText="true" />

            <!-- Register Button -->
            <Button fx:id="btnRegister" maxWidth="1.7976931348623157E308" onAction="#handleRegister" styleClass="btn-cyan" text="Register Account" />

            <!-- Back to Login Section -->
            <HBox alignment="CENTER" spacing="5">
                <Label style="-fx-text-fill: #78909c; -fx-font-size: 13px;" text="Already have an account?" />
                <Hyperlink onAction="#handleBackToLogin" styleClass="cyan-link" text="Sign In" />
            </HBox>
        </VBox>
    </VBox>

    <!-- ===== RIGHT SIDE — Brand Panel with Image Container ===== -->
    <VBox alignment="CENTER" spacing="20" styleClass="login-right-panel" HBox.hgrow="ALWAYS">
        <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>

        <ImageView fx:id="imgLogo" fitHeight="240" fitWidth="240" preserveRatio="true">
            <image>
                <Image url="@../image/mental-health.png" />
            </image>
        </ImageView>

        <Label styleClass="login-brand-title" text="Serenity Mental Health&#10;Therapy Center" textAlignment="CENTER" />
        <Label styleClass="login-brand-slogan" text="Nurturing minds, restoring peace.&#10;Your journey to wellness begins here." textAlignment="CENTER">
         <effect>
            <Glow level="0.86" />
         </effect></Label>
    </VBox>
</HBox>
