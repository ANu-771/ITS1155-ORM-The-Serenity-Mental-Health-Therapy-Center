<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<AnchorPane stylesheets="@../style/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.PatientManagementController">
    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox spacing="18">

        <VBox spacing="16" styleClass="card">
            <Label text="Patient Details" styleClass="card-header"/>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Patient ID" styleClass="form-label"/><TextField fx:id="txtId" promptText="P001" styleClass="text-field-modern" prefHeight="38"/></VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Full Name" styleClass="form-label"/><TextField fx:id="txtName" promptText="Patient name" styleClass="text-field-modern" prefHeight="38"/></VBox>
                <VBox spacing="4"><Label text="Date of Birth" styleClass="form-label"/><DatePicker fx:id="dpDob" promptText="Select DOB" styleClass="date-picker-modern" prefHeight="38" prefWidth="140"/></VBox>
            </HBox>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Contact Number" styleClass="form-label"/><TextField fx:id="txtContact" promptText="+94 77 000 0000" styleClass="text-field-modern" prefHeight="38"/></VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Gender" styleClass="form-label"/><ComboBox fx:id="cmbGender" promptText="Select Gender" styleClass="combo-modern" prefHeight="38" maxWidth="1.7976931348623157E308"/></VBox>
                <VBox spacing="4"><Label text="Registration Date" styleClass="form-label"/><DatePicker fx:id="dpRegDate" promptText="Select Reg. Date" styleClass="date-picker-modern" prefHeight="38" prefWidth="140"/></VBox>
            </HBox>
            <VBox spacing="4">
                <Label text="Medical History" styleClass="form-label"/>
                <TextArea fx:id="txtMedicalHistory" promptText="Enter medical history notes..." prefRowCount="2" styleClass="text-area-modern"/>
            </VBox>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <CheckBox fx:id="chkVerified" text="Interview Passed &amp; Documents Verified" styleClass="form-label" textFill="#2E7D32"/>
            </HBox>
            <HBox spacing="16" alignment="TOP_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Select Therapy Programs (Multiple Allowed)" styleClass="form-label"/>
                    <ScrollPane prefHeight="100" styleClass="text-field-modern">
                        <VBox fx:id="vboxPrograms" spacing="8" style="-fx-padding: 8; -fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox spacing="10"><Label text="Total Program Fee:" styleClass="form-label" minWidth="120"/><TextField fx:id="txtTotalFee" editable="false" styleClass="text-field-modern" prefHeight="30" promptText="0.00"/></HBox>
                    <HBox spacing="10"><Label text="Upfront Payment:" styleClass="form-label" minWidth="120"/><TextField fx:id="txtUpfrontPayment" styleClass="text-field-modern" prefHeight="30" promptText="Enter Amount"/></HBox>
                    <HBox spacing="10"><Label text="Due Balance:" styleClass="form-label" minWidth="120"/><TextField fx:id="txtDueBalance" editable="false" styleClass="text-field-modern" prefHeight="30" promptText="0.00"/></HBox>
                    <HBox spacing="10"><Label text="Payment Method:" styleClass="form-label" minWidth="120"/><ComboBox fx:id="cmbPaymentMethod" promptText="Method" styleClass="combo-modern" prefHeight="30" maxWidth="1.7976931348623157E308"/></HBox>
                </VBox>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Save" styleClass="btn-save" onAction="#handleSave" prefWidth="100"/>
                <Button text="Update" styleClass="btn-update" onAction="#handleUpdate" prefWidth="100"/>
                <Button text="Delete" styleClass="btn-delete" onAction="#handleDelete" prefWidth="100"/>
                <Button text="Clear" styleClass="btn-clear" onAction="#handleClear" prefWidth="100"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtSearch" promptText="🔍  Search by name..." styleClass="search-field" prefWidth="220" prefHeight="36" onKeyReleased="#handleSearch"/>
            </HBox>
        </VBox>

        <TableView fx:id="tblPatients" VBox.vgrow="ALWAYS" minHeight="300" maxHeight="Infinity">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
                <TableColumn fx:id="colName" text="Name" prefWidth="200"><cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory></TableColumn>
                <TableColumn fx:id="colDob" text="DOB" prefWidth="100"><cellValueFactory><PropertyValueFactory property="dob"/></cellValueFactory></TableColumn>
                <TableColumn fx:id="colContact" text="Contact" prefWidth="150"><cellValueFactory><PropertyValueFactory property="contactNumber"/></cellValueFactory></TableColumn>
                <TableColumn fx:id="colGender" text="Gender" prefWidth="100"><cellValueFactory><PropertyValueFactory property="gender"/></cellValueFactory></TableColumn>
                <TableColumn fx:id="colRegDate" text="Reg. Date" prefWidth="150"><cellValueFactory><PropertyValueFactory property="registrationDate"/></cellValueFactory></TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        </VBox>
    </ScrollPane>
</AnchorPane>
