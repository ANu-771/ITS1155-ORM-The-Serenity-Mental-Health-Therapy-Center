<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../style/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.TherapistManagementController">
    <VBox spacing="18" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <VBox spacing="16" styleClass="card">
            <Label styleClass="card-header" text="Therapist Details" />
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Therapist ID" /><TextField fx:id="txtId" prefHeight="38" promptText="T001" styleClass="text-field-modern" /></VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Full Name" /><TextField fx:id="txtName" prefHeight="38" promptText="Dr. Kamal Perera" styleClass="text-field-modern" /></VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Specialization" /><TextField fx:id="txtSpecialization" prefHeight="38" promptText="Cognitive Therapy" styleClass="text-field-modern" /></VBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Contact Number" /><TextField fx:id="txtContact" prefHeight="38" promptText="+94 77 123 4567" styleClass="text-field-modern" /></VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label styleClass="form-label" text="Email" /><TextField fx:id="txtEmail" prefHeight="38" promptText="doctor@gmail.com" styleClass="text-field-modern" /></VBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button onAction="#handleSave" prefWidth="100" styleClass="btn-save" text="Save" />
                <Button onAction="#handleUpdate" prefWidth="100" styleClass="btn-update" text="Update" />
                <Button onAction="#handleDelete" prefWidth="100" styleClass="btn-delete" text="Delete" />
                <Button onAction="#handleClear" prefWidth="100" styleClass="btn-clear" text="Clear" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtSearch" onKeyReleased="#handleSearch" prefHeight="36" prefWidth="220" promptText="🔍  Search..." styleClass="search-field" />
            </HBox>
        </VBox>

        <TableView fx:id="tblTherapists" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80" text="ID"><cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colName" prefWidth="180" text="Name"><cellValueFactory><PropertyValueFactory property="name" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colSpecialization" prefWidth="180" text="Specialization"><cellValueFactory><PropertyValueFactory property="specialization" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colContact" prefWidth="130" text="Contact"><cellValueFactory><PropertyValueFactory property="contactNumber" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colEmail" prefWidth="200" text="Email"><cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory></TableColumn>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
