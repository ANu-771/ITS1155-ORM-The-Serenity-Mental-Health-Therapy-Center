<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@../style/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.theserenitymentalhealththerapycenter.controller.ReportsController">
    <VBox spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- Stats Cards Row -->
        <HBox spacing="16">
            <VBox alignment="CENTER" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label fx:id="lblTotalPatients" styleClass="stat-value" text="0" />
                <Label styleClass="stat-label" text="Total Patients" />
            </VBox>
            <VBox alignment="CENTER" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label fx:id="lblTotalSessions" styleClass="stat-value" text="0" />
                <Label styleClass="stat-label" text="Total Sessions" />
            </VBox>
            <VBox alignment="CENTER" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label fx:id="lblTotalRevenue" styleClass="stat-value" text="LKR 0" />
                <Label styleClass="stat-label" text="Total Revenue" />
            </VBox>
            <VBox alignment="CENTER" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label fx:id="lblTotalTherapists" styleClass="stat-value" text="0" />
                <Label styleClass="stat-label" text="Active Therapists" />
            </VBox>
        </HBox>

        <!-- Report Actions -->
        <VBox spacing="16" styleClass="card">
            <Label styleClass="card-header" text="Generate Reports" />

            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4">
                    <Label styleClass="form-label" text="From Date" />
                    <DatePicker fx:id="dpFromDate" prefHeight="38" prefWidth="160" promptText="Select From Date" styleClass="date-picker-modern" />
                </VBox>
                <VBox spacing="4">
                    <Label styleClass="form-label" text="To Date" />
                    <DatePicker fx:id="dpToDate" prefHeight="38" prefWidth="160" promptText="Select To Date" styleClass="date-picker-modern" />
                </VBox>
                <VBox spacing="4">
                    <Label styleClass="form-label" text="Report Type" />
                    <ComboBox fx:id="cmbReportType" prefHeight="38" prefWidth="200" promptText="Select Type" styleClass="combo-modern" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <VBox alignment="BOTTOM_CENTER">
                    <Button fx:id="btnGenerate" onAction="#handleGenerate" styleClass="btn-report" text="📊  Generate Report" />
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
